# The one secret a Ralph run reads. Copy to .env (gitignored) and fill in what you need.
# Everything else — source, implementer, editor, protected, test_cmd, install_cmd — is a required
# argument in ralph.yaml, never here. How codex/copilot is driven is hardcoded, not tuned.
#
# Your target repo's own variables (DATABASE_URL, …) may live here too: Ralph loads the whole file
# so its suite inherits them, and reads only LINEAR_API_KEY for itself.

# Linear API key — required only when running with source: linear (and --linear-parent).
LINEAR_API_KEY=
